# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
# Must include the exact frontend origin, scheme included. Credentialed CORS
# rejects "*", so a missing entry here fails every logged-in request.
ALLOWED_ORIGINS=http://localhost:3000,https://sntc-kms.workers.dev

# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Neon's console hands you a `postgresql://` URL with `?sslmode=require`.
# asyncpg needs both changed: the driver prefix, and `ssl=require` — it does not
# understand libpq's `sslmode` and errors on the unknown keyword.
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/kms?ssl=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6380

# ── MQTT (HiveMQ Cloud) ───────────────────────────────────────────────────────
# HiveMQ Cloud is TLS-only on 8883 and rejects anonymous connections. Credentials
# come from the cluster's Access Management tab. The same values go into the
# firmware's config.h, which must also use the TLS client.
MQTT_HOST=xxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=kms-backend
MQTT_PASSWORD=
MQTT_TLS=true

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Auth timing ───────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600
PROXIMITY_CODE_TTL_SECONDS=120
PROXIMITY_FLAG_TTL_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TOTP_MAX_ATTEMPTS=5
TOTP_LOCKOUT_SECONDS=300

# ── Notification schedule ─────────────────────────────────────────────────────
REMINDER_BEFORE_DUE_MINUTES=30
ESCALATION_AFTER_DUE_HOURS=2

# ── Possession window ─────────────────────────────────────────────────────────
DEFAULT_POSSESSION_HOURS=6
