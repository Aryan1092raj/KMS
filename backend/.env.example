# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SKSS API
DEBUG=false
SECRET_KEY=your-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/skss

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL=rediss://default:password@your-upstash-host.upstash.io:6380

# ── MQTT (HiveMQ Cloud or self-hosted Mosquitto) ──────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Auth timing ───────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600
PROXIMITY_CODE_TTL_SECONDS=120
PROXIMITY_FLAG_TTL_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
TOTP_MAX_ATTEMPTS=5
TOTP_LOCKOUT_SECONDS=300

# ── Notification schedule ─────────────────────────────────────────────────────
REMINDER_BEFORE_DUE_MINUTES=30
ESCALATION_AFTER_DUE_HOURS=2

# ── Possession window ─────────────────────────────────────────────────────────
DEFAULT_POSSESSION_HOURS=6
